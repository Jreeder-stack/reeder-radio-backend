            "url": {
              "raw": "{{cad_url}}/api/radio/call",
              "host": [
                "{{cad_url}}"
              ],
              "path": [
                "api",
                "radio",
                "call"
              ]
            },
            "description": "Required: type, location. Priority values: emergency/urgent/high -> high, priority/medium -> medium, routine/low -> low.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"Traffic Stop\",\n  \"location\": \"123 Main St\",\n  \"city\": \"Springfield\",\n  \"zone\": \"Zone 3\",\n  \"units\": [\n    \"INDIANA-1\"\n  ],\n  \"priority\": \"routine\",\n  \"description\": \"Vehicle pulled over for speeding\",\n  \"caller_name\": \"Dispatch\",\n  \"caller_phone\": \"555-1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List active calls",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{cad_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{cad_url}}/api/radio/calls?status=active",
              "host": [
                "{{cad_url}}"
              ],
              "path": [
                "api",
                "radio",
                "calls"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "active"
                }
              ]
            },
            "description": "Lists active calls."
          }
        },
        {
          "name": "Get call details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{cad_key}}",
                "type": "text"
              }
            ],
