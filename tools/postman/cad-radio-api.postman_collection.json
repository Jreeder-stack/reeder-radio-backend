  "item": [
    {
      "name": "Unit Status & Location",
      "description": "",
      "item": [
        {
          "name": "Update unit status",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{cad_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{cad_url}}/api/radio/status",
              "host": [
                "{{cad_url}}"
              ],
              "path": [
                "api",
                "radio",
                "status"
              ]
            },
            "description": "POST /api/radio/status — body: { unit_id, status, timestamp?, channel? }. Required: unit_id, status. Valid statuses: on duty, off duty, busy, en route, on scene, available, assign, court, training, out of service, unavailable, special duty, not available, out of vehicle, detail.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unit_id\": \"{{unit_id}}\",\n  \"status\": \"on duty\",\n  \"timestamp\": \"1423\",\n  \"channel\": \"OPS1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Cycle unit status (single button)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{cad_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{cad_url}}/api/radio/unit/{{unit_id}}/status/cycle",
              "host": [
                "{{cad_url}}"
              ],
              "path": [
                "api",
                "radio",
                "unit",
                "{{unit_id}}",
                "status",
                "cycle"
              ]
            },
            "description": "POST /api/radio/unit/:unitId/status/cycle — optional body: { latitude?, longitude? }. Cycles off_duty<->on_duty, or on_duty->en_route->on_scene->on_duty when on a call. Cycles automatically: without active call off_duty <-> on_duty; with active call on_duty -> en_route -> on_scene -> on_duty.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": null,\n  \"longitude\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update unit zone",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{cad_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{cad_url}}/api/radio/zone",
              "host": [
                "{{cad_url}}"
              ],
              "path": [
                "api",
                "radio",
                "zone"
              ]
            },
            "description": "POST /api/radio/zone — body: { unit_id, zone }. Required: unit_id, zone.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unit_id\": \"{{unit_id}}\",\n  \"zone\": \"Zone 5\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get all units with status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{cad_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{cad_url}}/api/radio/status-check",
              "host": [
                "{{cad_url}}"
              ],
              "path": [
                "api",
                "radio",
                "status-check"
              ]
            },
            "description": "GET /api/radio/status-check — returns every unit with current status, zone, and last update. Returns every unit with current status, zone, and last update."
          }
        }
      ]
    },
