              "host": [
                "{{cad_url}}"
              ],
              "path": [
                "api",
                "radio",
                "call",
                "{{call_id}}"
              ]
            },
            "description": "Full call details including notes, disposition, assigned units."
          }
        },
        {
          "name": "Update a call",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{cad_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{cad_url}}/api/radio/call/{{call_id}}",
              "host": [
                "{{cad_url}}"
              ],
              "path": [
                "api",
                "radio",
                "call",
                "{{call_id}}"
              ]
            },
            "description": "All fields optional. Valid statuses: pending, active, assigned, en_route, on_scene, cleared, closed, cancelled.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"Domestic\",\n  \"location\": \"456 Oak Ave\",\n  \"city\": \"Springfield\",\n  \"zone\": \"Zone 1\",\n  \"priority\": \"high\",\n  \"status\": \"active\",\n  \"description\": \"Updated description\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
