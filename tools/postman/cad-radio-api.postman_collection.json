            "description": "PATCH /api/radio/call/:id — body: any of { type, location, city, zone, priority, status, description }. Valid statuses: pending, active, assigned, en_route, on_scene, cleared, closed, cancelled. All fields optional.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"Domestic\",\n  \"location\": \"456 Oak Ave\",\n  \"city\": \"Springfield\",\n  \"zone\": \"Zone 1\",\n  \"priority\": \"high\",\n  \"status\": \"active\",\n  \"description\": \"Updated description\"\n}",
