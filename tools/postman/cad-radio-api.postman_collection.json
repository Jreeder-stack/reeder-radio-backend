                "{{cad_url}}"
              ],
              "path": [
                "api",
                "radio",
                "clear"
              ]
            },
            "description": "Required: unit_id. call_id is optional (if omitted, just sets status to available).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unit_id\": \"{{unit_id}}\",\n  \"call_id\": \"{{call_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
