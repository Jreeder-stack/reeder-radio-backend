            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{cad_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{cad_url}}/api/radio/clear",
