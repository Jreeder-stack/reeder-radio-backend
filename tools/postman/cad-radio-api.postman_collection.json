            "description": "Required: unit_id, call_id.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unit_id\": \"{{unit_id}}\",\n  \"call_id\": \"{{call_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Clear unit from call",
