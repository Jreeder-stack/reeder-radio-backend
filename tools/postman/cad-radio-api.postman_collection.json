              "mode": "raw",
              "raw": "{\n  \"type\": \"Traffic Stop\",\n  \"location\": \"123 Main St\",\n  \"city\": \"Springfield\",\n  \"zone\": \"Zone 3\",\n  \"units\": [\n    \"INDIANA-1\"\n  ],\n  \"priority\": \"routine\",\n  \"description\": \"Vehicle pulled over for speeding\",\n  \"caller_name\": \"Dispatch\",\n  \"caller_phone\": \"555-1234\"\n}",
