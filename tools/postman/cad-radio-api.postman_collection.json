{
  "info": {
    "_postman_id": "cad-radio-api-collection",
    "name": "CAD Radio API",
    "description": "Full CAD Radio API surface for testing.\n\nAuth: every request sends `x-api-key: {{cad_key}}`.\nBase URL: `{{cad_url}}`.\n\nFill in `cad_url` and `cad_key` in the matching environment file before sending.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "x-api-key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{cad_key}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "unit_id",
      "value": "INDIANA-1"
    },
    {
      "key": "call_id",
      "value": ""
    },
    {
      "key": "chat_id",
      "value": ""
    },
    {
      "key": "vehicle_id",
      "value": ""
    },
    {
      "key": "category_key",
      "value": "call_natures"
    }
  ],
  "item": [
    {
      "name": "Unit Status & Location",
      "description": "",
      "item": [
        {
          "name": "Update unit status",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{cad_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{cad_url}}/api/radio/status",
              "host": [
                "{{cad_url}}"
              ],
              "path": [
                "api",
                "radio",
                "status"
              ]
            },
            "description": "Required: unit_id, status. Valid statuses: on duty, off duty, busy, en route, on scene, available, assign, court, training, out of service, unavailable, special duty, not available, out of vehicle, detail.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unit_id\": \"{{unit_id}}\",\n  \"status\": \"on duty\",\n  \"timestamp\": \"1423\",\n  \"channel\": \"OPS1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Cycle unit status (single button)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{cad_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{cad_url}}/api/radio/unit/{{unit_id}}/status/cycle",
              "host": [
                "{{cad_url}}"
              ],
              "path": [
                "api",
                "radio",
                "unit",
                "{{unit_id}}",
                "status",
                "cycle"
              ]
            },
            "description": "Cycles automatically: without active call off_duty <-> on_duty; with active call on_duty -> en_route -> on_scene -> on_duty.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": null,\n  \"longitude\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update unit zone",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{cad_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{cad_url}}/api/radio/zone",
              "host": [
                "{{cad_url}}"
              ],
              "path": [
                "api",
                "radio",
                "zone"
              ]
            },
            "description": "Required: unit_id, zone.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unit_id\": \"{{unit_id}}\",\n  \"zone\": \"Zone 5\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get all units with status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{cad_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{cad_url}}/api/radio/status-check",
              "host": [
                "{{cad_url}}"
              ],
              "path": [
                "api",
                "radio",
                "status-check"
              ]
            },
            "description": "Returns every unit with current status, zone, and last update."
          }
        }
      ]
    },
    {
      "name": "Calls for Service",
      "description": "",
      "item": [
        {
          "name": "Create a new call",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{cad_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
