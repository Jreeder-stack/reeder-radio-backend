              {
                "key": "x-api-key",
                "value": "{{cad_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{cad_url}}/api/radio/dispose",
              "host": [
                "{{cad_url}}"
              ],
              "path": [
                "api",
                "radio",
                "dispose"
              ]
            },
            "description": "Required: call_id, disposition.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"call_id\": \"{{call_id}}\",\n  \"disposition\": \"Report Filed\",\n  \"notes\": \"All units cleared, report pending\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Add note to a call",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{cad_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{cad_url}}/api/radio/note",
              "host": [
                "{{cad_url}}"
              ],
              "path": [
                "api",
                "radio",
                "note"
              ]
            },
            "description": "Required: call_id, note.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"call_id\": \"{{call_id}}\",\n  \"note\": \"Unit arrived on scene, making contact\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get unit's current call",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{cad_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{cad_url}}/api/radio/unit/{{unit_id}}/call",
              "host": [
                "{{cad_url}}"
              ],
              "path": [
                "api",
                "radio",
                "unit",
                "{{unit_id}}",
                "call"
              ]
            },
            "description": "Returns the unit's currently assigned call, or has_active_call=false."
          }
        }
      ]
