<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Phone-only readiness capabilities. Notification-policy access is a
         special user-granted setting used by the emergency/page channels. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <application
        android:label="COMMAND COMMS"
        tools:replace="android:label">

        <!-- A normal handset app must not register itself as the Android HOME
             launcher. Replace the shared radio/kiosk filter with LAUNCHER only. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter tools:node="removeAll" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Some Samsung/OEM Android builds report that full-screen intent
             permission is unavailable but do not expose the Settings activity
             for MANAGE_APP_USE_FULL_SCREEN_INTENTS. Without a local fallback,
             MainActivity's first-run readiness flow crashes after permissions. -->
        <activity
            android:name=".FullScreenIntentSettingsFallbackActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.settings.MANAGE_APP_USE_FULL_SCREEN_INTENTS" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="package" />
            </intent-filter>
        </activity>

        <!-- Phone flavor only. Keeps Bluetooth/wired/USB communication routing
             stable while the shared radio engine is active or the UI is closed. -->
        <service
            android:name=".audio.PhoneAudioRouteService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
